#include <bits/stdc++.h>
using namespace std;
using ll = long long;

void solve()
{
    int n; cin >> n;
    ll sum = 0;
    while(n--)
    {
        ll num; cin >> num;
        sum += num;
    }
    ll rad = sqrt(sum);
    if(rad*rad == sum) cout << "YES\n";
    else cout << "NO\n";
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t; cin >> t;
    while(t--) solve();
}
